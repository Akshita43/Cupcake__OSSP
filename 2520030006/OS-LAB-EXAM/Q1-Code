#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/wait.h>
int main(){
    char buf[50];
    mkfifo("myfifo", 0666);
    if(fork() == 0){
        int fd = open("myfifo", O_WRONLY);
        write(fd, "Hello via FIFO", 15);
        close(fd);
    } else {
        int fd = open("myfifo", O_RDONLY);
        read(fd, buf, sizeof buf);
        printf("Received: %s\n", buf);
        close(fd); wait(NULL);
        unlink("myfifo");
    }
    return 0;
}
