#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    printf("Main: PID=%d PPID=%d\n", getpid(), getppid());

    pid_t p = fork();

    if (p == 0)
        printf("Child: PID=%d PPID=%d\n", getpid(), getppid());
    else {
        wait(NULL);
        printf("Parent: PID=%d Child PID=%d\n", getpid(), p);
    }

    return 0;
}
